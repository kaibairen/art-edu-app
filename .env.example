# ========== 后端 API ==========
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1

# JWT（生产环境务必替换）
JWT_SECRET=change-me-in-production-art-edu-jwt
JWT_EXPIRES_IN=2h
JWT_REFRESH_DAYS=30

# PostgreSQL（与 docker-compose.yml 默认值对齐）
DATABASE_URL=postgresql://artedu:artedu@localhost:5432/artedu?schema=public

# 对象存储：local（本地目录 mock）或 s3（S3 / MinIO 兼容）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# 对外访问本地文件的基址，需与 API 监听地址一致
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/files

# S3 / MinIO（STORAGE_DRIVER=s3 时生效）
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=art-edu
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/art-edu

# CORS（管理端 / Flutter Web 调试）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 种子账号密码（仅开发）
SEED_ADMIN_PHONE=13800000000
SEED_ADMIN_PASSWORD=Admin123

# ========== 管理端 ==========
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ========== 移动端（--dart-define）==========
# API_BASE_URL=http://10.0.2.2:3000/api/v1
