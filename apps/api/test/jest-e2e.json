{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "esModuleInterop": true,
          "strict": false,
          "noImplicitAny": false,
          "emitDecoratorMetadata": true,
          "experimentalDecorators": true
        }
      }
    ]
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@art-edu/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
  }
}
