S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/art-edu
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ADMIN_PHONE=13800000000
