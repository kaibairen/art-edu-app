generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  teacher
  parent
}

enum UserStatus {
  active
  disabled
}

enum StudentStatus {
  active
  archived
}

enum WatermarkPosition {
  topLeft
  topRight
  bottomLeft
  bottomRight
  center
}

model User {
  id           String     @id @default(uuid())
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  displayName  String
  role         Role
  status       UserStatus @default(active)
  classNames   String[]   @default([])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  parentBindings ParentStudent[]
  uploadedWorks  Artwork[]       @relation("TeacherArtworks")
  refreshTokens  RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Student {
  id        String        @id @default(uuid())
  name      String
  className String?
  birthday  DateTime?
  gender    String?
  note      String?
  avatarUrl String?
  status    StudentStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  parentBindings ParentStudent[]
  artworks       Artwork[]
}

/// 家长-学员绑定（一对多：一名家长可绑定多名学员）
model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())
  parent    User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model Artwork {
  id          String   @id @default(uuid())
  studentId   String
  teacherId   String
  imageUrl    String
  thumbUrl    String
  title       String?
  courseTheme String?
  /// 创作时间（列表倒序键）；由旧 createdOn 迁入
  createdAt   DateTime
  commentText String?
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher User     @relation("TeacherArtworks", fields: [teacherId], references: [id])
  posters Poster[]

  @@index([studentId, createdAt])
}

model Poster {
  id          String   @id @default(uuid())
  artworkId   String
  templateKey String
  imageUrl    String
  recipe      Json
  createdAt   DateTime @default(now())
  artwork     Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([artworkId])
}

model OrgSetting {
  id                String             @id @default("default")
  orgName           String?
  logoUrl           String?
  watermarkText     String?
  watermarkOpacity  Float              @default(0.2)
  watermarkPosition WatermarkPosition  @default(bottomRight)
  updatedAt         DateTime           @updatedAt
}

model PosterTemplate {
  id          String   @id
  key         String   @unique
  name        String
  description String   @default("")
  enabled     Boolean  @default(true)
  previewUrl  String?
  metadata    Json     @default("{}")
  updatedAt   DateTime @updatedAt
}

/// 公开首页轮播。公开读仅 enabled=true。
model HomeCarousel {
  id        String   @id @default(uuid())
  imageUrl  String
  title     String?
  subtitle  String?
  linkUrl   String?
  sortOrder Int      @default(0)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

/// 公开优秀作品卡。库内即只存公开字段，不含点评 / 私人档案。
model HomeFeaturedArtwork {
  id                 String   @id @default(uuid())
  imageUrl           String
  title              String
  studentDisplayName String
  sortOrder          Int      @default(0)
  published          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([published, sortOrder])
}

/// 公开课程简介。无长文 body。
model HomeCourse {
  id        String   @id @default(uuid())
  title     String
  summary   String
  coverUrl  String?
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}
