generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  teacher
  parent
}

enum UserStatus {
  active
  disabled
}

enum StudentStatus {
  active
  archived
}

enum WatermarkPosition {
  topLeft
  topRight
  bottomLeft
  bottomRight
  center
}

model User {
  id           String     @id @default(uuid())
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  displayName  String
  role         Role
  status       UserStatus @default(active)
  classNames   String[]   @default([])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  parentBindings ParentStudent[]
  uploadedWorks  Artwork[]       @relation("TeacherArtworks")
  refreshTokens  RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Student {
  id        String        @id @default(uuid())
  name      String
  className String?
  birthday  DateTime?
  gender    String?
  note      String?
  avatarUrl String?
  status    StudentStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  parentBindings ParentStudent[]
  artworks       Artwork[]
}

/// 家长-学员绑定（一对多：一名家长可绑定多名学员）
model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())
  parent    User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model Artwork {
  id          String   @id @default(uuid())
  studentId   String
  teacherId   String
  imageUrl    String
  thumbUrl    String
  title       String?
  courseTheme String?
  /// 创作时间（列表倒序键）；由旧 createdOn 迁入
  createdAt   DateTime
  commentText String?
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher User     @relation("TeacherArtworks", fields: [teacherId], references: [id])
  posters Poster[]

  @@index([studentId, createdAt])
}

model Poster {
  id          String   @id @default(uuid())
  artworkId   String
  templateKey String
  imageUrl    String
  recipe      Json
  createdAt   DateTime @default(now())
  artwork     Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([artworkId])
}

model OrgSetting {
  id                String             @id @default("default")
  orgName           String?
  logoUrl           String?
  watermarkText     String?
  watermarkOpacity  Float              @default(0.2)
  watermarkPosition WatermarkPosition  @default(bottomRight)
  updatedAt         DateTime           @updatedAt
}

model PosterTemplate {
  id          String   @id
  key         String   @unique
  name        String
  description String   @default("")
  enabled     Boolean  @default(true)
  previewUrl  String?
  metadata    Json     @default("{}")
  updatedAt   DateTime @updatedAt
}

model HomeContent {
  id        String   @id @default(uuid())
  type      String
  title     String
  body      String?
  imageUrl  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
